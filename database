
    create sequence Inventory_SEQ start with 1 increment by 50;

    create sequence ProductInfo_SEQ start with 1 increment by 50;

    create table Inventory (
        createdAt timestamp(6),
        id bigint not null,
        updatedAt timestamp(6),
        location varchar(255) check ((location in ('DISTRICT_A','DISTRICT_B','DISTRICT_C','DISTRICT_D'))),
        primary key (id)
    );

    create table ProductInfo (
        id bigint not null,
        inventory_id bigint,
        productId bigint,
        quantity bigint,
        primary key (id)
    );

    alter table if exists ProductInfo 
       add constraint FKj4701fvtm8lbd48bgnsmlagyf 
       foreign key (inventory_id) 
       references Inventory;
